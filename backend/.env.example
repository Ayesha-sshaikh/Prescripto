PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/prescripto
JWT_SECRET=change-this-to-a-long-random-text

# Admin login (used on the admin panel)
ADMIN_EMAIL=admin@prescripto.com
ADMIN_PASSWORD=change-this-password

# Cloudinary (https://cloudinary.com, free account) - used for doctor/user photos
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# Currency symbol shown by the frontends is set in their own .env files
